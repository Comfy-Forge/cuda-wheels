=== WORKFLOW: Comfy-Forge/cuda-wheels | Run 33018100210 | Job 98356015239 ===

--- .github/workflows/build.yml ---

name: Build Wheels
run-name: "Build ${{ inputs.package }} wheels${{ inputs.platform != 'all' && format(' [{0}]', inputs.platform) || '' }}${{ inputs.cuda != 'all' && format(' cu{0}', inputs.cuda) || '' }}${{ inputs.pytorch != 'all' && inputs.pytorch != '' && format(' torch{0}', inputs.pytorch) || '' }}${{ inputs.python != 'all' && inputs.python != '' && format(' py{0}', inputs.python) || '' }}${{ inputs.overwrite == true && ' (overwrite)' || '' }}${{ inputs.max_jobs != '0' && format(' max_jobs={0}', inputs.max_jobs) || '' }}"

on:
  workflow_dispatch:
    inputs:
      update_index:
        description: 'Regenerate + deploy the index after the build (default: no — dispatch Update Index separately)'
        required: false
        type: boolean
        default: false
      package:
        description: 'Package to build ("all", or a package name from packages/ -- generate_matrix.py rejects unknown names with the known list)'
        required: true
        type: string
        default: all
      overwrite:
        description: 'Rebuild and overwrite existing wheels'
        required: false
        type: boolean
        default: false
      platform:
        description: 'Platform filter (or "all")'
        required: false
        type: choice
        options:
          - all
          - linux
          - linux_aarch64
          - windows
        default: all
      cuda:
        description: 'CUDA version filter — e.g. "12.8", or "all" (validated against the grid by generate_matrix.py)'
        required: false
        type: string
        default: all
      pytorch:
        description: 'PyTorch version filter — full (e.g. "2.11.0") or major.minor (e.g. "2.11"), or "all"'
        required: false
        type: string
        default: 'all'
      python:
        description: 'Python version filter — e.g. "3.12", or "all"'
        required: false
        type: string
        default: 'all'
      max_jobs:
        description: 'Max parallel compilation jobs (0 = use package default)'
        required: false
        type: string
        default: '0'

jobs:
  generate-matrix:
    runs-on: ubuntu-latest
    outputs:
      matrix: ${{ steps.generate.outputs.matrix }}
    steps:
      - uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install dependencies
        run: pip install pyyaml

      - name: Generate build matrix
        id: generate
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          OVERWRITE_FLAG=""
          if [ "${{ inputs.overwrite }}" = "true" ]; then
            OVERWRITE_FLAG="--overwrite"
          fi
          python scripts/generate_matrix.py --package "${{ inputs.package }}" --platform "${{ inputs.platform || 'all' }}" --cuda "${{ inputs.cuda || 'all' }}" --pytorch "${{ inputs.pytorch || 'all' }}" --python "${{ inputs.python || 'all' }}" --output matrix.json $OVERWRITE_FLAG
          echo "matrix=$(cat matrix.json)" >> $GITHUB_OUTPUT

  build-linux:
    name: Linux ${{ matrix.package }} py${{ matrix.python }} cu${{ matrix.cuda_short }} torch${{ matrix.pytorch }}
    needs: generate-matrix
    # Skip when the linux matrix is empty (mirrors build-windows guard).
    if: ${{ fromJson(needs.generate-matrix.outputs.matrix).linux.include[0] != null }}
    runs-on: ubuntu-latest
    # Builds run inside the manylinux_2_28 container (AlmaLinux 8, glibc
    # 2.28): the wheel's glibc floor is a POLICY that tracks PyTorch's
    # manylinux baseline, not an accident of the runner image.
    # The host free-disk step is gone
    # (host paths are unreachable from the container); stock runner disk
    # (~28GB) must suffice -- revisit if a giant build hits ENOSPC.
    container:
      image: quay.io/pypa/manylinux_2_28_x86_64
      options: --privileged   # swapon needs CAP_SYS_ADMIN
    strategy:
      fail-fast: false
      matrix: ${{ fromJson(needs.generate-matrix.outputs.matrix).linux }}
    permissions:
      contents: read

    steps:
      - name: Container prerequisites (gh CLI, procps)
        run: |
          dnf install -y -q 'dnf-command(config-manager)' >/dev/null
          dnf config-manager --add-repo https://cli.github.com/packages/rpm/gh-cli.repo >/dev/null
          dnf install -y -q gh procps-ng >/dev/null
          gh --version | head -1

      - uses: actions/checkout@v4

      - name: Compute wheel filename
        id: meta
        run: |
          # Version detection is done in generate_matrix.py - just use matrix values
          PKG_NAME="${{ matrix.package }}"
          PKG_VERSION="${{ matrix.version }}"
          CUDA_SHORT="${{ matrix.cuda_short }}"
          TORCH_SHORT=$(echo "${{ matrix.pytorch }}" | cut -d. -f1,2)
          PY_SHORT=$(echo "${{ matrix.python }}" | tr -d '.')
          # Prefix without platform tag (auditwheel changes linux_x86_64 → manylinux_*)
          WHEEL_PREFIX="${PKG_NAME}-${PKG_VERSION}+cu${CUDA_SHORT}torch${TORCH_SHORT}-cp${PY_SHORT}-cp${PY_SHORT}-"
          # Abi-agnostic wheels (py3-none / cpXY-abi3) satisfy every python
          # cell -- the exists-check must accept them too (grep -E below).
          # 27 of 44 packages declare no version and none is discoverable
          # upstream, so PKG_VERSION is empty for them. Interpolating it
          # produced "^pkg-\+cu128torch2.8-..." which cannot match a real
          # "pkg-1.5.3+cu128torch2.8-..." name -- the check silently matched
          # nothing. Mirror generate_matrix.wheel_exists(), which drops the
          # version anchor when the version is unknown.
          if [ -n "$PKG_VERSION" ]; then VER_RE="$PKG_VERSION"; else VER_RE="[0-9][^-]*"; fi
          WHEEL_PREFIX_RE="^${PKG_NAME}-${VER_RE}\\+cu${CUDA_SHORT}torch${TORCH_SHORT}-(cp${PY_SHORT}-cp${PY_SHORT}|py3-none|cp[0-9]+-abi3)-"
          echo "wheel_prefix_re=$WHEEL_PREFIX_RE" >> $GITHUB_OUTPUT

          echo "wheel_prefix=$WHEEL_PREFIX" >> $GITHUB_OUTPUT
          echo "pkg_name=$PKG_NAME" >> $GITHUB_OUTPUT
          echo "pkg_version=$PKG_VERSION" >> $GITHUB_OUTPUT

      - name: Check if wheel exists in release
        id: check
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          WHEEL_PREFIX="${{ steps.meta.outputs.wheel_prefix }}"
          RELEASE="${{ matrix.package }}-latest"
          echo "Checking release $RELEASE for: ${WHEEL_PREFIX}*.whl"
          mkdir -p dist

          if [ "${{ inputs.overwrite }}" = "true" ]; then
            echo "exists=false" >> $GITHUB_OUTPUT
            echo "::notice::Overwrite enabled, will rebuild"
          else
            # Require manylinux (auditwheel-repaired) wheels on Linux
            MATCHING=$({ gh release view "$RELEASE" --json assets -q ".assets[].name" 2>/dev/null || true; } | grep -E "${{ steps.meta.outputs.wheel_prefix_re }}" | grep "manylinux" | grep -v "aarch64" | head -1 || true)
            if [ -n "$MATCHING" ]; then
              echo "exists=true" >> $GITHUB_OUTPUT
              echo "::notice::Wheel exists in release: $MATCHING"
              gh release download "$RELEASE" -p "$MATCHING" -D dist
            else
              echo "exists=false" >> $GITHUB_OUTPUT
              echo "::notice::No manylinux wheel found matching: ${WHEEL_PREFIX}*"
            fi
          fi

      - name: Setup CUDA
        if: steps.check.outputs.exists != 'true'
        uses: ./.github/actions/setup-cuda
        with:
          cuda-version: ${{ matrix.cuda }}
          platform: linux
          installer-type: ${{ matrix.cuda_installer }}
          extra-components: ${{ matrix.extra_cuda_components }}

      - name: Add swap space (safety net)
        if: steps.check.outputs.exists != 'true'
        # Swap is a PARACHUTE, not a strategy: if the resource monitor shows
        # swap in active use, the fix is fewer jobs (max_jobs), never "more
        # swap" -- thrashing a compile through a swapfile is slower than
        # running it narrower. 8GB exists so a brief peak becomes a slow
        # minute instead of a SIGKILL at hour 3.
        run: |
          # container runs as root (--privileged for swapon).
          # The swapfile MUST live on a host bind-mount (RUNNER_TEMP -> host
          # ext4): the container's own paths (/mnt included) are overlayfs,
          # and swapon on overlayfs fails with "Invalid argument".
          fallocate -l 8G "$RUNNER_TEMP/swapfile"
          chmod 600 "$RUNNER_TEMP/swapfile"
          mkswap "$RUNNER_TEMP/swapfile"
          swapon "$RUNNER_TEMP/swapfile"

      - name: Setup build environment
        if: steps.check.outputs.exists != 'true'
        uses: ./.github/actions/setup-build-env
        with:
          python-version: ${{ matrix.python }}
          pytorch-version: ${{ matrix.pytorch }}
          cuda-short: ${{ matrix.cuda_short }}
          platform: linux
          extra-deps: ${{ matrix.extra_deps }}

      - name: Build wheel
        if: steps.check.outputs.exists != 'true'
        uses: ./.github/actions/build-wheel
        with:
          source-repo: ${{ matrix.source_repo }}
          source-tag: ${{ matrix.source_tag }}
          pre-build-script: ${{ matrix.pre_build_script }}
          arch-list: ${{ matrix.arch_list }}
          cuda-version: ${{ matrix.cuda }}
          cuda-short: ${{ matrix.cuda_short }}
          pytorch-version: ${{ matrix.pytorch }}
          platform: linux
          jobs: ${{ inputs.max_jobs != '0' && inputs.max_jobs || matrix.jobs }}
          clone-recursive: ${{ matrix.clone_recursive }}
          patch-script: ${{ matrix.patch_script }}
          build-subdir: ${{ matrix.build_subdir }}
          nvcc-flags: ${{ matrix.nvcc_flags }}
          nvcc-threads: ${{ matrix.nvcc_threads }}
          shard-index: ${{ matrix.shard_index }}
          shard-count: ${{ matrix.shard_count }}
          shard-filter: ${{ matrix.shard_filter }}
          package: ${{ matrix.package }}
          python-version: ${{ matrix.python }}

      - name: Upload artifact
        # Compile-shard jobs upload their .o tarball via the build-wheel action's
        # own upload step; this wheel-upload only runs in full-build mode.
        # `if-no-files-found: ignore` lets the step succeed when dist/ is empty.
        # Also require that this job actually produced a wheel. Without the
        # `exists` check a job that found its wheel already published downloads
        # it into dist/ and re-uploads it here, and the release job then puts it
        # back with `--clobber` -- a delete-then-upload of a live asset, for no
        # gain. Combined with a transient `gh` failure in the skip check that is
        # a whole package's assets deleted and recreated.
        if: matrix.shard_count == 0 && steps.check.outputs.exists != 'true'
        uses: actions/upload-artifact@v4
        with:
          name: ${{ matrix.package }}-linux-py${{ matrix.python }}-cu${{ matrix.cuda_short }}-torch${{ matrix.pytorch }}
          path: |
            dist/*.whl
            dist/*.whl.metadata
          if-no-files-found: ignore


  build-linux-aarch64:
    name: ARM ${{ matrix.package }} py${{ matrix.python }} cu${{ matrix.cuda_short }} torch${{ matrix.pytorch }}
    needs: generate-matrix
    if: ${{ fromJson(needs.generate-matrix.outputs.matrix).linux_aarch64.include[0] != null }}
    # GitHub's hosted ARM runners (free for public repos).
    runs-on: ubuntu-24.04-arm
    # Same policy as x86: the ARM floor is manylinux_2_28 (fixes the 2.39
    # accident that excluded Ubuntu-22.04 Grace hosts and JetPack 6).
    container:
      image: quay.io/pypa/manylinux_2_28_aarch64
      options: --privileged   # swapon needs CAP_SYS_ADMIN (same as x86)
    strategy:
      fail-fast: false
      matrix: ${{ fromJson(needs.generate-matrix.outputs.matrix).linux_aarch64 }}
    permissions:
      contents: read

    steps:
      - name: Container prerequisites (gh CLI, procps)
        run: |
          dnf install -y -q 'dnf-command(config-manager)' >/dev/null
          dnf config-manager --add-repo https://cli.github.com/packages/rpm/gh-cli.repo >/dev/null
          dnf install -y -q gh procps-ng >/dev/null

      - uses: actions/checkout@v4

      - name: Compute wheel filename
        id: meta
        run: |
          PKG_NAME="${{ matrix.package }}"
          PKG_VERSION="${{ matrix.version }}"
          CUDA_SHORT="${{ matrix.cuda_short }}"
          TORCH_SHORT=$(echo "${{ matrix.pytorch }}" | cut -d. -f1,2)
          PY_SHORT=$(echo "${{ matrix.python }}" | tr -d '.')
          WHEEL_PREFIX="${PKG_NAME}-${PKG_VERSION}+cu${CUDA_SHORT}torch${TORCH_SHORT}-cp${PY_SHORT}-cp${PY_SHORT}-"
          # Abi-agnostic wheels (py3-none / cpXY-abi3) satisfy every python
          # cell -- the exists-check must accept them too (grep -E below).
          # 27 of 44 packages declare no version and none is discoverable
          # upstream, so PKG_VERSION is empty for them. Interpolating it
          # produced "^pkg-\+cu128torch2.8-..." which cannot match a real
          # "pkg-1.5.3+cu128torch2.8-..." name -- the check silently matched
          # nothing. Mirror generate_matrix.wheel_exists(), which drops the
          # version anchor when the version is unknown.
          if [ -n "$PKG_VERSION" ]; then VER_RE="$PKG_VERSION"; else VER_RE="[0-9][^-]*"; fi
          WHEEL_PREFIX_RE="^${PKG_NAME}-${VER_RE}\\+cu${CUDA_SHORT}torch${TORCH_SHORT}-(cp${PY_SHORT}-cp${PY_SHORT}|py3-none|cp[0-9]+-abi3)-"
          echo "wheel_prefix_re=$WHEEL_PREFIX_RE" >> $GITHUB_OUTPUT
          echo "wheel_prefix=$WHEEL_PREFIX" >> $GITHUB_OUTPUT

      - name: Check if wheel exists in release
        id: check
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          WHEEL_PREFIX="${{ steps.meta.outputs.wheel_prefix }}"
          RELEASE="${{ matrix.package }}-latest"
          echo "Checking release $RELEASE for: ${WHEEL_PREFIX}*aarch64*.whl"
          mkdir -p dist
          if [ "${{ inputs.overwrite }}" = "true" ]; then
            echo "exists=false" >> $GITHUB_OUTPUT
            echo "::notice::Overwrite enabled, will rebuild"
          else
            MATCHING=$({ gh release view "$RELEASE" --json assets -q ".assets[].name" 2>/dev/null || true; } | grep -E "${{ steps.meta.outputs.wheel_prefix_re }}" | grep "aarch64" | head -1 || true)
            if [ -n "$MATCHING" ]; then
              echo "exists=true" >> $GITHUB_OUTPUT
              echo "::notice::Wheel exists in release: $MATCHING"
            else
              echo "exists=false" >> $GITHUB_OUTPUT
            fi
          fi

      - name: Setup CUDA
        if: steps.check.outputs.exists != 'true'
        uses: ./.github/actions/setup-cuda
        with:
          cuda-version: ${{ matrix.cuda }}
          platform: linux
          installer-type: ${{ matrix.cuda_installer }}
          extra-components: ${{ matrix.extra_cuda_components }}

      - name: Add swap space (safety net)
        if: steps.check.outputs.exists != 'true'
        # Added 2026-08-26. This step existed on the x86 build job and nowhere
        # else, so ARM ran on the runner's stock ~3GB against x86's 11GB on an
        # identical 16GB box -- an asymmetry nobody chose, and the direct cause
        # of three separate ARM-only failures in one afternoon:
        #   dpvo_cuda  swap gate: peak swap 2.88/3.0GB, MemAvailable 0.17GB
        #   sageattn3  "runner lost communication" (OOM kill), 49 min in
        #   torchao    same, twice, recorded in its own package.yml
        # The x86 lane survived the identical dpvo_cuda workload having used
        # MORE swap (4.17GB) -- it simply had somewhere to page to, so
        # MemAvailable never collapsed and the gate passed it.
        #
        # Swap remains a PARACHUTE, not a strategy: if resmon shows swap in
        # active use the fix is fewer jobs, never more swap. What this buys is
        # that a brief peak becomes a slow minute instead of the runner being
        # killed outright -- and a killed runner is the worst case, because the
        # swap gate is a LATER step and never executes, so the build dies with
        # no diagnostic at all.
        run: |
          # Same constraints as x86: the container runs as root (--privileged
          # for CAP_SYS_ADMIN) and the swapfile MUST live on a host bind-mount
          # (RUNNER_TEMP -> host ext4), because the container's own paths are
          # overlayfs and swapon there fails with "Invalid argument".
          fallocate -l 8G "$RUNNER_TEMP/swapfile"
          chmod 600 "$RUNNER_TEMP/swapfile"
          mkswap "$RUNNER_TEMP/swapfile"
          swapon "$RUNNER_TEMP/swapfile"
          free -g | head -2

      - name: Setup build environment
        if: steps.check.outputs.exists != 'true'
        uses: ./.github/actions/setup-build-env
        with:
          python-version: ${{ matrix.python }}
          pytorch-version: ${{ matrix.pytorch }}
          cuda-short: ${{ matrix.cuda_short }}
          platform: linux
          extra-deps: ${{ matrix.extra_deps }}

      - name: Build wheel
        if: steps.check.outputs.exists != 'true'
        uses: ./.github/actions/build-wheel
        with:
          source-repo: ${{ matrix.source_repo }}
          source-tag: ${{ matrix.source_tag }}
          pre-build-script: ${{ matrix.pre_build_script }}
          arch-list: ${{ matrix.arch_list }}
          cuda-version: ${{ matrix.cuda }}
          cuda-short: ${{ matrix.cuda_short }}
          pytorch-version: ${{ matrix.pytorch }}
          platform: linux
          jobs: ${{ inputs.max_jobs != '0' && inputs.max_jobs || matrix.jobs }}
          clone-recursive: ${{ matrix.clone_recursive }}
          patch-script: ${{ matrix.patch_script }}
          build-subdir: ${{ matrix.build_subdir }}
          nvcc-flags: ${{ matrix.nvcc_flags }}
          nvcc-threads: ${{ matrix.nvcc_threads }}
          # Shard inputs from the matrix (were hardcoded 0/0 until
          # 2026-08-22: a sharded ARM package fanned out N IDENTICAL full
          # builds and the ARM link job never had shard caches to merge).
          shard-index: ${{ matrix.shard_index }}
          shard-count: ${{ matrix.shard_count }}
          shard-filter: ${{ matrix.shard_filter }}
          package: ${{ matrix.package }}
          python-version: ${{ matrix.python }}

      - name: Upload artifact
        # Compile-shard jobs hand off via the action's ccache artifact;
        # only full builds upload a wheel here (mirrors build-linux).
        if: matrix.shard_count == 0 && steps.check.outputs.exists != 'true'
        uses: actions/upload-artifact@v4
        with:
          name: ${{ matrix.package }}-linux_aarch64-py${{ matrix.python }}-cu${{ matrix.cuda_short }}-torch${{ matrix.pytorch }}
          path: |
            dist/*.whl
            dist/*.whl.metadata
          if-no-files-found: ignore

  link-linux:
    name: Link ${{ matrix.package }} py${{ matrix.python }} cu${{ matrix.cuda_short }} torch${{ matrix.pytorch }}
    # Runs after compile-shard jobs finish. Only fans out for sharded packages
    # (link-matrix is empty for unsharded — the job is then skipped entirely
    # because the strategy matrix has no entries to iterate over).
    # generate-matrix is in needs because we reference its `matrix` output;
    # GH Actions only exposes outputs from direct needs.
    needs: [generate-matrix, build-linux]
    # always(): without it GitHub applies the implicit "all needs
    # succeeded" rule, so ONE failed shard out of 60 marks the whole
    # build matrix job failed, every link job is skipped, and the run
    # publishes ZERO wheels for that CUDA line (llama cu12.6 lost 6
    # cells to a single container-setup flake, 2026-08-24). The link
    # job already asserts its shard artifacts are present, so a
    # genuinely broken cell still fails loudly on its own.
    if: ${{ always() && needs.build-linux.result != 'cancelled' && fromJson(needs.generate-matrix.outputs.matrix).linux_link.include[0] != null }}
    runs-on: ubuntu-latest
    container:
      image: quay.io/pypa/manylinux_2_28_x86_64
    strategy:
      fail-fast: false
      matrix: ${{ fromJson(needs.generate-matrix.outputs.matrix).linux_link }}
    permissions:
      contents: read

    steps:
      - name: Container prerequisites (gh CLI, procps)
        run: |
          dnf install -y -q 'dnf-command(config-manager)' >/dev/null
          dnf config-manager --add-repo https://cli.github.com/packages/rpm/gh-cli.repo >/dev/null
          dnf install -y -q gh procps-ng >/dev/null

      - name: Free disk space
        if: matrix.free_disk_space == true
        run: |
          sudo rm -rf /usr/share/dotnet &
          sudo rm -rf /usr/local/lib/android &
          sudo rm -rf /opt/ghc &
          sudo rm -rf /opt/hostedtoolcache/CodeQL &
          sudo rm -rf /usr/share/swift &
          sudo rm -rf /usr/local/graalvm &
          sudo rm -rf /usr/local/.ghcup &
          sudo rm -rf /opt/hostedtoolcache/go &
          sudo apt-get clean &
          wait
          df -h

      - uses: actions/checkout@v4

      - name: Setup CUDA
        uses: ./.github/actions/setup-cuda
        with:
          cuda-version: ${{ matrix.cuda }}
          platform: linux
          installer-type: ${{ matrix.cuda_installer }}
          extra-components: ${{ matrix.extra_cuda_components }}

      - name: Setup build environment
        uses: ./.github/actions/setup-build-env
        with:
          python-version: ${{ matrix.python }}
          pytorch-version: ${{ matrix.pytorch }}
          cuda-short: ${{ matrix.cuda_short }}
          platform: linux
          extra-deps: ${{ matrix.extra_deps }}

      - name: Link sharded wheel
        # link-only: true tells the action to download all N shard artifacts
        # for this (pkg, py, cuda, torch) tuple, extract them into build/temp,
        # and run pip wheel which will link-only (skip recompile since .o's are
        # already present and fresh).
        uses: ./.github/actions/build-wheel
        with:
          source-repo: ${{ matrix.source_repo }}
          source-tag: ${{ matrix.source_tag }}
          pre-build-script: ${{ matrix.pre_build_script }}
          arch-list: ${{ matrix.arch_list }}
          cuda-version: ${{ matrix.cuda }}
          cuda-short: ${{ matrix.cuda_short }}
          pytorch-version: ${{ matrix.pytorch }}
          platform: linux
          jobs: ${{ inputs.max_jobs != '0' && inputs.max_jobs || matrix.jobs }}
          clone-recursive: ${{ matrix.clone_recursive }}
          patch-script: ${{ matrix.patch_script }}
          build-subdir: ${{ matrix.build_subdir }}
          nvcc-flags: ${{ matrix.nvcc_flags }}
          nvcc-threads: ${{ matrix.nvcc_threads }}
          shard-index: '0'
          shard-count: ${{ matrix.shard_count }}
          shard-filter: ${{ matrix.shard_filter }}
          link-only: 'true'
          package: ${{ matrix.package }}
          python-version: ${{ matrix.python }}

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: ${{ matrix.package }}-linux-py${{ matrix.python }}-cu${{ matrix.cuda_short }}-torch${{ matrix.pytorch }}
          path: |
            dist/*.whl
            dist/*.whl.metadata

  link-linux-aarch64:
    name: ARM Link ${{ matrix.package }} py${{ matrix.python }} cu${{ matrix.cuda_short }} torch${{ matrix.pytorch }}
    # Runs after compile-shard jobs finish. Only fans out for sharded packages
    # (link-matrix is empty for unsharded — the job is then skipped entirely
    # because the strategy matrix has no entries to iterate over).
    # generate-matrix is in needs because we reference its `matrix` output;
    # GH Actions only exposes outputs from direct needs.
    needs: [generate-matrix, build-linux-aarch64]
    # always(): without it GitHub applies the implicit "all needs
    # succeeded" rule, so ONE failed shard out of 60 marks the whole
    # build matrix job failed, every link job is skipped, and the run
    # publishes ZERO wheels for that CUDA line (llama cu12.6 lost 6
    # cells to a single container-setup flake, 2026-08-24). The link
    # job already asserts its shard artifacts are present, so a
    # genuinely broken cell still fails loudly on its own.
    if: ${{ always() && needs.build-linux-aarch64.result != 'cancelled' && fromJson(needs.generate-matrix.outputs.matrix).linux_aarch64_link.include[0] != null }}
    runs-on: ubuntu-24.04-arm
    container:
      image: quay.io/pypa/manylinux_2_28_aarch64
    strategy:
      fail-fast: false
      matrix: ${{ fromJson(needs.generate-matrix.outputs.matrix).linux_aarch64_link }}
    permissions:
      contents: read

    steps:
      - name: Container prerequisites (gh CLI, procps)
        run: |
          dnf install -y -q 'dnf-command(config-manager)' >/dev/null
          dnf config-manager --add-repo https://cli.github.com/packages/rpm/gh-cli.repo >/dev/null
          dnf install -y -q gh procps-ng >/dev/null

      - name: Free disk space
        if: matrix.free_disk_space == true
        run: |
          sudo rm -rf /usr/share/dotnet &
          sudo rm -rf /usr/local/lib/android &
          sudo rm -rf /opt/ghc &
          sudo rm -rf /opt/hostedtoolcache/CodeQL &
          sudo rm -rf /usr/share/swift &
          sudo rm -rf /usr/local/graalvm &
          sudo rm -rf /usr/local/.ghcup &
          sudo rm -rf /opt/hostedtoolcache/go &
          sudo apt-get clean &
          wait
          df -h

      - uses: actions/checkout@v4

      - name: Setup CUDA
        uses: ./.github/actions/setup-cuda
        with:
          cuda-version: ${{ matrix.cuda }}
          platform: linux
          installer-type: ${{ matrix.cuda_installer }}
          extra-components: ${{ matrix.extra_cuda_components }}

      - name: Setup build environment
        uses: ./.github/actions/setup-build-env
        with:
          python-version: ${{ matrix.python }}
          pytorch-version: ${{ matrix.pytorch }}
          cuda-short: ${{ matrix.cuda_short }}
          platform: linux
          extra-deps: ${{ matrix.extra_deps }}

      - name: Link sharded wheel
        # link-only: true tells the action to download all N shard artifacts
        # for this (pkg, py, cuda, torch) tuple, extract them into build/temp,
        # and run pip wheel which will link-only (skip recompile since .o's are
        # already present and fresh).
        uses: ./.github/actions/build-wheel
        with:
          source-repo: ${{ matrix.source_repo }}
          source-tag: ${{ matrix.source_tag }}
          pre-build-script: ${{ matrix.pre_build_script }}
          arch-list: ${{ matrix.arch_list }}
          cuda-version: ${{ matrix.cuda }}
          cuda-short: ${{ matrix.cuda_short }}
          pytorch-version: ${{ matrix.pytorch }}
          platform: linux
          jobs: ${{ inputs.max_jobs != '0' && inputs.max_jobs || matrix.jobs }}
          clone-recursive: ${{ matrix.clone_recursive }}
          patch-script: ${{ matrix.patch_script }}
          build-subdir: ${{ matrix.build_subdir }}
          nvcc-flags: ${{ matrix.nvcc_flags }}
          nvcc-threads: ${{ matrix.nvcc_threads }}
          shard-index: '0'
          shard-count: ${{ matrix.shard_count }}
          shard-filter: ${{ matrix.shard_filter }}
          link-only: 'true'
          package: ${{ matrix.package }}
          python-version: ${{ matrix.python }}

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          # linux_aarch64, NOT linux: this job and link-linux (:465) otherwise
          # upload the FINISHED WHEEL under one name. upload-artifact@v4 has
          # overwrite:false, so the loser 409s after an hour of work and one
          # architecture never reaches `release`. The unsharded aarch64 job
          # (:364) already gets this right; only the link lane drifted.
          name: ${{ matrix.package }}-linux_aarch64-py${{ matrix.python }}-cu${{ matrix.cuda_short }}-torch${{ matrix.pytorch }}
          path: |
            dist/*.whl
            dist/*.whl.metadata

  build-windows:
    name: Windows ${{ matrix.package }} py${{ matrix.python }} cu${{ matrix.cuda_short }} torch${{ matrix.pytorch }}
    needs: generate-matrix
    # Skip when the windows matrix is empty (e.g. a linux-only sharded
    # package). Without this guard GH Actions errors with
    # "matrix must define at least one vector" and flags the whole
    # workflow as failure even though release succeeds.
    if: ${{ fromJson(needs.generate-matrix.outputs.matrix).windows.include[0] != null }}
    runs-on: windows-2022
    strategy:
      fail-fast: false
      matrix: ${{ fromJson(needs.generate-matrix.outputs.matrix).windows }}
    permissions:
      contents: read

    steps:

      - name: Ensure Git\bin on PATH (so shell:bash works)
        if: runner.os == 'Windows'
        shell: powershell
        run: |
          "C:\Program Files\Git\bin" | Out-File -FilePath $env:GITHUB_PATH -Encoding utf8 -Append

      - name: Runner identity (debug)
        shell: powershell
        run: |
          echo "runner.name=${{ runner.name }} runner.os=${{ runner.os }} hostname=$env:COMPUTERNAME user=$(whoami)"
          echo "--- whoami /groups ---"
          whoami /groups | Select-String -Pattern "docker|admin|users|service|network" -CaseSensitive:$false
          echo "--- end debug ---"
      - name: Enable long paths
        shell: powershell
        run: git config --system core.longpaths true

      - uses: actions/checkout@v4

      - name: Compute wheel filename
        id: meta
        shell: bash
        run: |
          # Version detection is done in generate_matrix.py - just use matrix values
          PKG_NAME="${{ matrix.package }}"
          PKG_VERSION="${{ matrix.version }}"
          CUDA_SHORT="${{ matrix.cuda_short }}"
          TORCH_SHORT=$(echo "${{ matrix.pytorch }}" | cut -d. -f1,2)
          PY_SHORT=$(echo "${{ matrix.python }}" | tr -d '.')
          WHEEL_PREFIX="${PKG_NAME}-${PKG_VERSION}+cu${CUDA_SHORT}torch${TORCH_SHORT}-cp${PY_SHORT}-cp${PY_SHORT}-"
          # Abi-agnostic wheels (py3-none / cpXY-abi3) satisfy every python
          # cell -- the exists-check must accept them too (grep -E below).
          # 27 of 44 packages declare no version and none is discoverable
          # upstream, so PKG_VERSION is empty for them. Interpolating it
          # produced "^pkg-\+cu128torch2.8-..." which cannot match a real
          # "pkg-1.5.3+cu128torch2.8-..." name -- the check silently matched
          # nothing. Mirror generate_matrix.wheel_exists(), which drops the
          # version anchor when the version is unknown.
          if [ -n "$PKG_VERSION" ]; then VER_RE="$PKG_VERSION"; else VER_RE="[0-9][^-]*"; fi
          WHEEL_PREFIX_RE="^${PKG_NAME}-${VER_RE}\\+cu${CUDA_SHORT}torch${TORCH_SHORT}-(cp${PY_SHORT}-cp${PY_SHORT}|py3-none|cp[0-9]+-abi3)-"
          echo "wheel_prefix_re=$WHEEL_PREFIX_RE" >> $GITHUB_OUTPUT

          echo "wheel_prefix=$WHEEL_PREFIX" >> $GITHUB_OUTPUT
          echo "pkg_name=$PKG_NAME" >> $GITHUB_OUTPUT
          echo "pkg_version=$PKG_VERSION" >> $GITHUB_OUTPUT

      - name: Check if wheel exists in release
        id: check
        shell: bash
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          WHEEL_PREFIX="${{ steps.meta.outputs.wheel_prefix }}"
          RELEASE="${{ matrix.package }}-latest"
          echo "Checking release $RELEASE for: ${WHEEL_PREFIX}*.whl"
          mkdir -p dist

          if [ "${{ inputs.overwrite }}" = "true" ]; then
            echo "exists=false" >> $GITHUB_OUTPUT
            echo "::notice::Overwrite enabled, will rebuild"
          else
            MATCHING=$({ gh release view "$RELEASE" --json assets -q ".assets[].name" 2>/dev/null || true; } | grep -E "${{ steps.meta.outputs.wheel_prefix_re }}" | grep "win_amd64" | head -1 || true)
            if [ -n "$MATCHING" ]; then
              echo "exists=true" >> $GITHUB_OUTPUT
              echo "::notice::Wheel exists in release: $MATCHING"
              gh release download "$RELEASE" -p "$MATCHING" -D dist
            else
              echo "exists=false" >> $GITHUB_OUTPUT
              echo "::notice::No win_amd64 wheel found matching: ${WHEEL_PREFIX}*"
            fi
          fi

      - name: Setup CUDA
        if: steps.check.outputs.exists != 'true'
        uses: ./.github/actions/setup-cuda
        with:
          cuda-version: ${{ matrix.cuda }}
          platform: windows
          installer-type: ${{ matrix.cuda_installer }}
          extra-components: ${{ matrix.extra_cuda_components }}

      - name: Setup build environment
        if: steps.check.outputs.exists != 'true'
        uses: ./.github/actions/setup-build-env
        with:
          python-version: ${{ matrix.python }}
          pytorch-version: ${{ matrix.pytorch }}
          cuda-short: ${{ matrix.cuda_short }}
          platform: windows
          extra-deps: ${{ matrix.extra_deps }}

      - name: Build wheel
        if: steps.check.outputs.exists != 'true'
        uses: ./.github/actions/build-wheel
        with:
          source-repo: ${{ matrix.source_repo }}
          source-tag: ${{ matrix.source_tag }}
          pre-build-script: ${{ matrix.pre_build_script }}
          arch-list: ${{ matrix.arch_list }}
          cuda-version: ${{ matrix.cuda }}
          cuda-short: ${{ matrix.cuda_short }}
          pytorch-version: ${{ matrix.pytorch }}
          platform: windows
          jobs: ${{ inputs.max_jobs != '0' && inputs.max_jobs || matrix.jobs }}
          clone-recursive: ${{ matrix.clone_recursive }}
          patch-script: ${{ matrix.patch_script }}
          build-subdir: ${{ matrix.build_subdir }}
          nvcc-flags: ${{ matrix.nvcc_flags }}
          nvcc-threads: ${{ matrix.nvcc_threads }}
          shard-index: ${{ matrix.shard_index }}
          shard-count: ${{ matrix.shard_count }}
          shard-filter: ${{ matrix.shard_filter }}
          package: ${{ matrix.package }}
          python-version: ${{ matrix.python }}

      - name: Upload artifact
        # Compile-shard jobs upload their .o tarball via the build-wheel action's
        # own upload step; this wheel-upload only runs in full-build mode.
        # Also require that this job actually produced a wheel. Without the
        # `exists` check a job that found its wheel already published downloads
        # it into dist/ and re-uploads it here, and the release job then puts it
        # back with `--clobber` -- a delete-then-upload of a live asset, for no
        # gain. Combined with a transient `gh` failure in the skip check that is
        # a whole package's assets deleted and recreated.
        if: matrix.shard_count == 0 && steps.check.outputs.exists != 'true'
        uses: actions/upload-artifact@v4
        with:
          name: ${{ matrix.package }}-windows-py${{ matrix.python }}-cu${{ matrix.cuda_short }}-torch${{ matrix.pytorch }}
          path: |
            dist/*.whl
            dist/*.whl.metadata

  link-windows:
    name: Link ${{ matrix.package }} py${{ matrix.python }} cu${{ matrix.cuda_short }} torch${{ matrix.pytorch }} (Windows)
    # Mirror of link-linux for sharded Windows packages.
    needs: [generate-matrix, build-windows]
    # always(): without it GitHub applies the implicit "all needs
    # succeeded" rule, so ONE failed shard out of 60 marks the whole
    # build matrix job failed, every link job is skipped, and the run
    # publishes ZERO wheels for that CUDA line (llama cu12.6 lost 6
    # cells to a single container-setup flake, 2026-08-24). The link
    # job already asserts its shard artifacts are present, so a
    # genuinely broken cell still fails loudly on its own.
    if: ${{ always() && needs.build-windows.result != 'cancelled' && fromJson(needs.generate-matrix.outputs.matrix).windows_link.include[0] != null }}
    runs-on: windows-2022
    strategy:
      fail-fast: false
      matrix: ${{ fromJson(needs.generate-matrix.outputs.matrix).windows_link }}
    permissions:
      contents: read

    steps:
      - name: Ensure Git\bin on PATH (so shell:bash works)
        if: runner.os == 'Windows'
        shell: powershell
        run: |
          "C:\Program Files\Git\bin" | Out-File -FilePath $env:GITHUB_PATH -Encoding utf8 -Append

      - name: Enable long paths
        shell: powershell
        run: git config --system core.longpaths true

      - uses: actions/checkout@v4

      - name: Setup CUDA
        uses: ./.github/actions/setup-cuda
        with:
          cuda-version: ${{ matrix.cuda }}
          platform: windows
          installer-type: ${{ matrix.cuda_installer }}
          extra-components: ${{ matrix.extra_cuda_components }}

      - name: Setup build environment
        uses: ./.github/actions/setup-build-env
        with:
          python-version: ${{ matrix.python }}
          pytorch-version: ${{ matrix.pytorch }}
          cuda-short: ${{ matrix.cuda_short }}
          platform: windows
          extra-deps: ${{ matrix.extra_deps }}

      - name: Link sharded wheel
        uses: ./.github/actions/build-wheel
        with:
          source-repo: ${{ matrix.source_repo }}
          source-tag: ${{ matrix.source_tag }}
          pre-build-script: ${{ matrix.pre_build_script }}
          arch-list: ${{ matrix.arch_list }}
          cuda-version: ${{ matrix.cuda }}
          cuda-short: ${{ matrix.cuda_short }}
          pytorch-version: ${{ matrix.pytorch }}
          platform: windows
          jobs: ${{ inputs.max_jobs != '0' && inputs.max_jobs || matrix.jobs }}
          clone-recursive: ${{ matrix.clone_recursive }}
          patch-script: ${{ matrix.patch_script }}
          build-subdir: ${{ matrix.build_subdir }}
          nvcc-flags: ${{ matrix.nvcc_flags }}
          nvcc-threads: ${{ matrix.nvcc_threads }}
          shard-index: '0'
          shard-count: ${{ matrix.shard_count }}
          shard-filter: ${{ matrix.shard_filter }}
          link-only: 'true'
          package: ${{ matrix.package }}
          python-version: ${{ matrix.python }}

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: ${{ matrix.package }}-windows-py${{ matrix.python }}-cu${{ matrix.cuda_short }}-torch${{ matrix.pytorch }}
          path: |
            dist/*.whl
            dist/*.whl.metadata

  release:
    needs:
      - build-linux
      - build-linux-aarch64
      - link-linux
      - link-linux-aarch64
      - build-windows
      - link-windows
    # Release runs whenever ANY build/link path produced a result
    # (not cancelled).
    if: always() && (needs.build-linux.result != 'cancelled' || needs.build-linux-aarch64.result != 'cancelled' || needs.link-linux.result != 'cancelled' || needs.link-linux-aarch64.result != 'cancelled' || needs.build-windows.result != 'cancelled' || needs.link-windows.result != 'cancelled')
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - uses: actions/checkout@v4

      - name: Download all artifacts
        uses: actions/download-artifact@v4
        with:
          path: artifacts

      - name: Create releases per package
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          # Collect wheels and group by package. If artifacts/ doesn't exist
          # (no upstream job produced any artifacts -- e.g. every cell
          # was skipped after the first one completed and uploaded its wheel,
          # or every job failed pre-build), there's nothing to release.
          mkdir -p wheels
          if [ -d artifacts ]; then
            find artifacts -name "*.whl" -exec cp {} wheels/ \;
            # PEP 658 sidecars ride along with their wheel. Collected on their
            # own pattern because `*.whl` does not match `*.whl.metadata`.
            find artifacts -name "*.whl.metadata" -exec cp {} wheels/ \; 2>/dev/null || true
          else
            echo "::notice::no artifacts/ directory -- no wheels were uploaded; nothing to release"
            exit 0
          fi

          echo "Collected wheels:"
          ls -la wheels/

          # Extract unique package names from wheel filenames
          # Wheel format: <package>-<version>+<suffix>-<python>-...
          cd wheels
          for whl in *.whl; do
            if [ -f "$whl" ]; then
              # Extract package name (everything before first -)
              pkg=$(echo "$whl" | sed 's/-.*//')
              echo "Found package: $pkg"
              mkdir -p "../releases/$pkg"
              cp "$whl" "../releases/$pkg/"
              # Carry the wheel's PEP 658 sidecar into the same package dir.
              # This loop iterates *.whl only, so without this the sidecar is
              # collected but never grouped, and the upload below finds none.
              [ -f "$whl.metadata" ] && cp "$whl.metadata" "../releases/$pkg/"
            fi
          done
          cd ..

          # Create a release for each package
          for pkg_dir in releases/*/; do
            pkg=$(basename "$pkg_dir")
            echo "Creating release for: $pkg"

            # Example pin for the notes: the first wheel's full version INCLUDING
            # the combo tag, e.g. 1.5.3+cu128torch2.8. A complete local version
            # selects exactly one wheel, which is the only unambiguous install.
            example_pin=$(ls "$pkg_dir"/*.whl | head -1 | sed "s/.*${pkg}-//" | sed 's/-cp[0-9].*//')

            NOTES="Pre-built ${pkg} wheels with CUDA support."$'\n\n'"**Install** -- pick the build matching your installed torch and CUDA:"$'\n'"\`\`\`bash"$'\n'"pip install \"${pkg}==${example_pin}\" --extra-index-url https://comfy-forge.github.io/cuda-wheels/"$'\n'"\`\`\`"$'\n\n'"This index is *selected from*, not resolved. A wheel's CUDA and torch versions live in its local version tag (\`+cu128torch2.8\`), and pip cannot match those against your environment -- an unpinned \`pip install ${pkg}\` resolves to the highest combo in this release, not the one your machine can load. Pin the exact build as above, or let the helper choose it:"$'\n'"https://comfy-forge.github.io/cuda-wheels/dashboard/install.html"
            gh release create "${pkg}-latest" \
              --title "${pkg} CUDA Wheels" \
              --notes "$NOTES" \
              --latest=false \
              "$pkg_dir"/*.whl \
            || gh release upload "${pkg}-latest" "$pkg_dir"/*.whl --clobber
            # PEP 658 sidecars. Uploaded as <wheel>.metadata assets so their
            # URL is exactly the wheel URL + ".metadata", which is where a
            # resolver looks. Best-effort: a missing sidecar simply means the
            # deps index falls back to opening the wheel, which is the same
            # answer the no-deps index gives.
            shopt -s nullglob
            sidecars=( "$pkg_dir"/*.whl.metadata )
            shopt -u nullglob
            if [ ${#sidecars[@]} -gt 0 ]; then
              gh release upload "${pkg}-latest" "${sidecars[@]}" --clobber \
                && echo "uploaded ${#sidecars[@]} PEP 658 sidecar(s) for ${pkg}" \
                || echo "::warning::sidecar upload failed for ${pkg}; the deps index will fall back to reading the wheel"
            fi
            # Rolling-release hygiene (CW-ADR-0002): for every cell that now
            # holds wheels from multiple versions, keep only the highest.
            pip install -q pyyaml 2>/dev/null || true
            python scripts/prune_superseded.py --repo "$GITHUB_REPOSITORY" --package "$pkg"
          done

  update-index:
    needs: release
    # build.yml and update-index.yml both deploy the built _site to gh-pages with
    # force_orphan, which replaces the branch wholesale -- so two DEPLOYS
    # overlapping would silently overwrite each other. Serialise the deploy
    # JOB only: workflow-level concurrency put every build run into this
    # queue, where each new dispatch cancelled the pending index update (and
    # queued builds cancelled each other -- fatal for multi-package rollouts).
    concurrency:
      group: gh-pages-deploy
      cancel-in-progress: false
    # Off by default: a build run should not be able to break the live index.
    # Freshly published wheels appear in the index on the next Update Index
    # run (push to main, manual dispatch, or a build dispatched with
    # update_index=true).
    if: always() && needs.release.result == 'success' && inputs.update_index == true
    runs-on: ubuntu-latest
    environment: deploy-index
    permissions:
      contents: write
      pages: write

    steps:
      - uses: actions/checkout@v4

      - name: Checkout current gh-pages (for the shorter-index guard)
        continue-on-error: true
        uses: actions/checkout@v4
        with:
          ref: gh-pages
          path: previous-site

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install dependencies
        run: pip install pyyaml

      - name: Render matrix page from the committed PCWM snapshot
        run: python scripts/fetch_torch_matrix.py --from-json defaults/scraped_torch_matrix.json --html _site/matrix

      # These two were missing here while present in update-index.yml. Since
      # the deploy uses force_orphan (replaces the branch wholesale), a build
      # run with update_index=true would have DELETED the live /find/ and
      # /archs/ pages. Kept in sync until this job is replaced by a
      # workflow_call into update-index.yml.
      - name: Build the "Find your wheel" page
        run: python scripts/generate_findwheel.py --out _site

      - name: Build the GPU architectures page
        run: python scripts/generate_archs_page.py --out _site

      - name: Generate PEP 503 index
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          CUW_SITE_DIR: _site
        run: python scripts/generate_index.py --out _site --previous previous-site

      - name: Deploy to GitHub Pages
        uses: peaceiris/actions-gh-pages@v4
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          publish_dir: ./_site
          force_orphan: true

